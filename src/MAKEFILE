# Makefile for TRINKET.SYS -- built with Borland C++ 3.1 / Turbo Assembler
# 3.1, same toolchain and SMALL model as sdpp-main. See DRIVER.C's
# Initialize() banner and NOTES.md (if present) for provenance.
#
# NOTE: use $(INCLUDE)/$(LIB) (make macro expansion, resolved by make
# itself before it invokes bcc/tlink directly), NOT %INCLUDE%/%LIB%
# (COMMAND.COM batch-file expansion -- doesn't apply here since make
# never routes through a spawned shell).

CC=bcc -c -ms -Z -O -Ol -Oe -I$(INCLUDE) -L$(LIB)
ASM=tasm -mx

.c.obj:
   $(CC) $<

.asm.obj:
   $(ASM) $*

trinket.sys:   header.obj cprint.obj sd.obj trinket.obj driver.obj
   tlink -t -m -s -n -L$(LIB) header cprint sd trinket driver, trinket.sys, , cs.lib

clean:
   del *.obj
   del trinket.sys

driver.obj: driver.c cprint.c cprint.h standard.h driver.h sd.h
sd.obj:     sd.c sd.h standard.h driver.h diskio.h
trinket.obj: trinket.c diskio.h integer.h cprint.h
header.obj: header.asm
