5 DIM H(4),B$(3)
10 DEF FNW(X$)=ASC(LEFT$(X$,1))+256!*ASC(MID$(X$,2,1))
20 DEF FNL(X$)=FNW(LEFT$(X$,2))+65536*FNW(MID$(X$,3,2))
25 DEF FNB(X)=X-256*INT(X/256)
27 DEF FNQ(X)=X-512*INT(X/512)
28 DEF FNM$(X,Y)=MID$(B$(INT((X-1)/128)),X-128*INT((X-1)/128),Y)
30 P=888:C=2:E=0:TM=100000:PRINT "TRINKET.SYS copier - LPT1 at 378h"
32 FOR I=0 TO 3:B$(I)=SPACE$(128):NEXT
40 PRINT "Destination is A:TRINKET.SYS; this overwrites that file."
50 INPUT "Press Enter with the Trinket connected and target disk ready";Z$
60 OUT P+2,0:FOR D=1 TO 800:T=INP(128):NEXT:OUT P+2,2:FOR D=1 TO 4:T=INP(128):NEXT
70 V=3:GOSUB 700:V=1:GOSUB 700:TM=1000000:GOSUB 820:TM=100000
80 IF E THEN GOTO 900
90 IF H(0)<>0 THEN PRINT "SD card initialization failed":GOTO 990
100 L=0:GOSUB 600
110 IF E THEN GOTO 900
120 IF FNW(FNM$(12,2))=512 THEN PART=0:GOTO 180
130 IF FNM$(511,2)<>CHR$(85)+CHR$(170) THEN PRINT "No MBR signature":GOTO 990
140 PART=-1
150 FOR J=0 TO 3:O=447+16*J
160 T=ASC(FNM$(O+4,1)):IF T=4 OR T=6 OR T=14 THEN PART=FNL(FNM$(O+8,4)):J=3
170 NEXT:IF PART<0 THEN PRINT "No FAT16 primary partition":GOTO 990
180 L=PART:GOSUB 600:IF E THEN GOTO 900
190 IF FNW(FNM$(12,2))<>512 THEN PRINT "Not 512-byte FAT16":GOTO 990
200 SC=ASC(FNM$(14,1)):RV=FNW(FNM$(15,2)):NF=ASC(FNM$(17,1))
210 RE=FNW(FNM$(18,2)):FZ=FNW(FNM$(23,2))
220 IF SC=0 OR NF=0 OR RE=0 OR FZ=0 THEN PRINT "Invalid FAT16 BPB":GOTO 990
230 RS=INT((RE*32+511)/512):FA=PART+RV:ROOT=FA+NF*FZ:DST=ROOT+RS
240 TS=FNW(FNM$(20,2)):IF TS=0 THEN TS=FNL(FNM$(33,4))
250 NC=INT((TS-RV-NF*FZ-RS)/SC)
260 IF NC<4085 OR NC>65524 THEN PRINT "Volume is not FAT16":GOTO 990
270 FD=0
280 FOR S=0 TO RS-1:L=ROOT+S:GOSUB 600
290 IF E THEN GOTO 900
300 FOR J=0 TO 15:O=1+J*32
310 IF ASC(FNM$(O,1))=0 THEN J=15:S=RS
320 IF FNM$(O,11)="TRINKET SYS" THEN FD=1:CLU=FNW(FNM$(O+26,2)):SIZE=FNL(FNM$(O+28,4)):J=15:S=RS
330 NEXT:NEXT
340 IF FD=0 OR SIZE=0 THEN PRINT "Root TRINKET.SYS not found":GOTO 990
350 IF CLU<2 OR CLU>65524 THEN PRINT "Bad first cluster":GOTO 990
360 OPEN "A:TRINKET.SYS" FOR OUTPUT AS #2:CLOSE #2
370 OPEN "R",#2,"A:TRINKET.SYS",128:FIELD #2,128 AS F$
380 REM DATA SECTORS, WRITTEN IN FAT CHAIN ORDER
390 RM=SIZE:R=0
400 FOR K=0 TO SC-1
410 IF RM>0 THEN L=DST+(CLU-2)*SC+K:GOSUB 600
420 IF E THEN GOTO 900
440 FOR Q=0 TO 3:IF RM<=0 THEN GOTO 445
442 T$=B$(Q):IF RM<128 THEN T$=LEFT$(T$,RM)+STRING$(128-RM,0)
444 LSET F$=T$:R=R+1:PUT #2,R:RM=RM-128
445 NEXT
450 NEXT
460 IF RM<=0 THEN GOTO 530
470 FS=FA+INT(CLU*2/512):FO=1+FNQ(CLU*2)
480 L=FS:GOSUB 600
485 IF E THEN GOTO 900
490 CLU=FNW(FNM$(FO,2))
500 IF CLU<2 OR CLU>=65520 THEN PRINT "Broken FAT chain":GOTO 990
510 GOTO 400
530 CLOSE #2:PRINT "Copied";SIZE;"bytes; file is padded to";R*128;"bytes"
540 PRINT "Install with DEVICE=A:TRINKET.SYS in CONFIG.SYS, then reboot."
550 END
600 REM READ ONE RAW SD SECTOR AT L INTO B$
610 V=3:GOSUB 700:V=2:GOSUB 700
620 V=FNB(L):GOSUB 700:V=FNB(INT(L/256)):GOSUB 700
630 V=FNB(INT(L/65536)):GOSUB 700:V=FNB(INT(L/16777216)):GOSUB 700
640 V=1:GOSUB 700:GOSUB 820
650 IF E THEN RETURN
660 IF H(0)<>0 OR H(3)+256*H(4)<>512 THEN PRINT "SD read error, sector";L:E=1:RETURN
675 C=C OR 8:OUT P+2,C
680 FOR I=1 TO 512:GOSUB 730
682 IF E THEN RETURN
684 Y=INT((I-1)/128):MID$(B$(Y),I-128*Y,1)=CHR$(V):NEXT
690 C=C AND 247:OUT P+2,C:RETURN
700 REM WRITE ONE BYTE V; C IS CONTROL REGISTER SHADOW
705 IF E THEN RETURN
710 OUT P,V:C=C OR 4:OUT P+2,C:W=8:GOSUB 790:IF E THEN RETURN
720 C=C AND 251:OUT P+2,C:W=0:GOSUB 790:RETURN
730 REM READ ONE BYTE V FROM DEVICE NIBBLES, LOW NIBBLE FIRST
735 IF E THEN RETURN
740 C=C OR 1:OUT P+2,C:C=C OR 4:OUT P+2,C:W=8:GOSUB 790:IF E THEN RETURN
750 A=(INP(P+1) AND 240)/16:C=C AND 251:OUT P+2,C:W=0:GOSUB 790:IF E THEN RETURN
760 C=C AND 254:OUT P+2,C:C=C OR 4:OUT P+2,C:W=8:GOSUB 790:IF E THEN RETURN
770 V=A OR (INP(P+1) AND 240):C=C AND 251:OUT P+2,C:W=0:GOSUB 790:RETURN
780 REM WAIT FOR ERROR/NACK STATUS BIT 3 TO EQUAL W
790 OK=0:FOR T=1 TO TM
792 IF (INP(P+1) AND 8)=W THEN OK=1:T=TM
794 NEXT
800 IF OK=0 THEN E=1:PRINT "Parallel-port handshake timed out"
810 RETURN
820 REM GET SD RESULT HEADER H(0..4); ENTER IN WRITE DIRECTION
830 V=3:GOSUB 700:IF E THEN RETURN
840 C=C OR 8:OUT P+2,C
850 FOR I=0 TO 4:GOSUB 730
852 IF E THEN RETURN
854 H(I)=V:NEXT
860 C=C AND 247:OUT P+2,C:RETURN
900 ON ERROR GOTO 920:CLOSE #2
910 ON ERROR GOTO 0:PRINT "Transfer stopped; do not install the partial file.":GOTO 990
920 RESUME 910
990 END
